{
  "name": "@volchoklv/portpilot",
  "version": "0.4.0",
  "description": "Put your local dev servers on autopilot — clean .test domains with HTTPS, zero port management for Next.js, Vite, React, and any Node.js project.",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "portpilot": "./dist/cli/index.js",
    "pp": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test \"test/*.test.ts\"",
    "start": "node dist/cli/index.js",
    "service": "node dist/service/index.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "development",
    "localhost",
    "proxy",
    "nextjs",
    "vite",
    "pnpm",
    "yarn",
    "bun",
    "dev-server",
    "local-development",
    "reverse-proxy",
    "https",
    "ssl",
    "mkcert",
    "mcp",
    "http2",
    "worktree"
  ],
  "author": "VolchokLV <admin@volchok.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolchokLV/portpilot.git"
  },
  "homepage": "https://portpilot.dev",
  "bugs": {
    "url": "https://github.com/VolchokLV/portpilot/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo.png"
  ],
  "dependencies": {
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "http-proxy-3": "^2.0.2",
    "ora": "^9.4.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
